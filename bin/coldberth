#!/usr/bin/env bash
# Coldberth — Hermes Agent + vLLM local stack (a cold dock berth for local inference).
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
DATA="${COLDBERTH_DATA:-$HOME/.local/share/coldberth}"
VENV="${COLDBERTH_VENV:-$DATA/.venv}"
PORT="${COLDBERTH_PORT:-8000}"
MODEL="${COLDBERTH_MODEL:-solidrust/Hermes-3-Llama-3.1-8B-AWQ}"
SERVED_NAME="${COLDBERTH_SERVED_NAME:-hermes3:8b}"
MAX_LEN="${COLDBERTH_MAX_MODEL_LEN:-65536}"
GPU_UTIL="${COLDBERTH_GPU_UTIL:-0.75}"
KV_CACHE_DTYPE="${COLDBERTH_KV_CACHE_DTYPE:-fp8}"
PROVIDER_NAME="${COLDBERTH_PROVIDER:-coldberth}"
HERMES_CONFIG="${HERMES_CONFIG:-$HOME/.hermes/config.yaml}"
LOG_FILE="${COLDBERTH_LOG:-$DATA/vllm.log}"
PID_FILE="${COLDBERTH_PID_FILE:-$DATA/vllm.pid}"
PYTHON="${COLDBERTH_PYTHON:-3.14}"

usage() {
  cat <<EOF
Coldberth — local Hermes Agent + vLLM (cold dock berth for local inference)

Usage: coldberth <command>

Commands:
  deps        Check OS packages for GPU inference (curl, git, NVIDIA driver)
  install     Install uv venv + vLLM, link this CLI to ~/.local/bin
  update      git pull coldberth + upgrade vLLM + refresh CLI link
  start       Run vLLM (foreground by default; -b/--background to detach)
  stop        Stop vLLM — free GPU VRAM for games / other tasks
  pause       Alias for stop
  doctor      Check GPU, CUDA, venv, and endpoint health
  recommend   Detect GPU VRAM and suggest model/settings for Hermes Agent
  bench       Tool-call latency test against vLLM
  configure   Point Hermes config at vLLM (local or remote URL)
  urls        Print vLLM API URLs (local + LAN for distributed Hermes)
  firewall    Check / allow LAN firewall access for remote Hermes (port ${PORT})
  status      Show vLLM /v1/models status
  help        Show this help

Environment:
  COLDBERTH_DIR     Git checkout for update (default: ~/.local/share/coldberth/src)
  COLDBERTH_PYTHON   Python for vLLM venv (default: 3.14)
  COLDBERTH_DATA, COLDBERTH_VENV, COLDBERTH_PORT, COLDBERTH_MODEL
  COLDBERTH_GPU_UTIL, COLDBERTH_MAX_MODEL_LEN, COLDBERTH_PROVIDER
  COLDBERTH_LOG, COLDBERTH_PID_FILE
  COLDBERTH_FIREWALL=allow|skip  (non-interactive firewall prompt on start --lan)
  COLDBERTH_UPDATE_CHECK=skip    (disable update-available notice on start)
  COLDBERTH_UPDATE_CHECK_INTERVAL  Seconds between git fetches (default: 21600)
  COLDBERTH_DEPS=allow|skip      (non-interactive deps prompt on install)

  vLLM binds 127.0.0.1 by default; use "start --lan" to expose on the LAN (no API auth)

Docs: https://dataknifeai.github.io/coldberth/
Repo: https://github.com/DataKnifeAI/coldberth
EOF
}

require_linux() {
  [[ "$(uname -s)" == Linux ]] || { echo "ERROR: Linux only"; exit 1; }
}

os_family() {
  local id id_like
  [[ -f /etc/os-release ]] || { echo unknown; return; }
  # shellcheck disable=SC1091
  source /etc/os-release
  id="${ID,,}"
  id_like="${ID_LIKE,,}"
  case "$id" in
    arch|cachyos|manjaro|endeavouros|garuda) echo arch; return ;;
    ubuntu|debian|linuxmint|pop|neon|elementary|zorin|kali) echo debian; return ;;
    fedora|nobara|ultramarine) echo fedora; return ;;
    rhel|centos|rocky|almalinux|ol|amzn) echo rhel; return ;;
    opensuse*|sles|sled) echo suse; return ;;
  esac
  [[ "$id_like" == *arch* ]] && echo arch && return
  [[ "$id_like" == *debian* ]] && echo debian && return
  [[ "$id_like" == *fedora* ]] && echo fedora && return
  [[ "$id_like" == *rhel* ]] && echo rhel && return
  [[ "$id_like" == *suse* ]] && echo suse && return
  echo unknown
}

pkg_backend() {
  if command -v pacman &>/dev/null; then
    echo pacman
  elif command -v apt &>/dev/null; then
    echo apt
  elif command -v apt-get &>/dev/null; then
    echo apt
  elif command -v dnf &>/dev/null; then
    echo dnf
  elif command -v yum &>/dev/null; then
    echo yum
  elif command -v zypper &>/dev/null; then
    echo zypper
  else
    echo unknown
  fi
}

nvidia_smi_ok() {
  command -v nvidia-smi &>/dev/null && nvidia-smi &>/dev/null
}

nvcc_ok() {
  command -v nvcc &>/dev/null || [[ -x /opt/cuda/bin/nvcc ]]
}

pkg_update() {
  local backend="$1"
  case "$backend" in
    apt)
      if command -v apt &>/dev/null; then
        sudo apt update -qq
      else
        sudo apt-get update -qq
      fi
      ;;
    dnf) sudo dnf makecache -q ;;
    yum) sudo yum makecache -q || true ;;
    zypper) sudo zypper --non-interactive refresh -q ;;
    pacman) ;;
    *) return 1 ;;
  esac
}

pkg_install() {
  local backend="$1"
  shift
  local -a pkgs=("$@")
  [[ ${#pkgs[@]} -gt 0 ]] || return 0
  [[ "$backend" != unknown ]] || return 1

  echo "+ ${backend} install ${pkgs[*]}"
  case "$backend" in
    pacman)
      sudo pacman -S --needed --noconfirm "${pkgs[@]}"
      ;;
    apt)
      pkg_update apt
      if command -v apt &>/dev/null; then
        sudo apt install -y "${pkgs[@]}"
      else
        sudo apt-get install -y "${pkgs[@]}"
      fi
      ;;
    dnf)
      pkg_update dnf
      sudo dnf install -y "${pkgs[@]}"
      ;;
    yum)
      pkg_update yum
      sudo yum install -y "${pkgs[@]}"
      ;;
    zypper)
      pkg_update zypper
      sudo zypper --non-interactive install --auto-agree-with-licenses "${pkgs[@]}"
      ;;
    *)
      return 1
      ;;
  esac
}

deps_nvidia_packages() {
  local family="$1"
  local backend="$2"
  case "$family" in
    arch) echo "nvidia-open-dkms nvidia-utils" ;;
    debian) echo "nvidia-driver" ;;
    fedora) echo "akmod-nvidia xorg-x11-drv-nvidia xorg-x11-drv-nvidia-libs" ;;
    rhel)
      if [[ "$backend" == yum ]]; then
        echo "kmod-nvidia nvidia-driver"
      else
        echo "akmod-nvidia xorg-x11-drv-nvidia xorg-x11-drv-nvidia-libs"
      fi
      ;;
    suse) echo "nvidia-computeG06 nvidia-glG06" ;;
    *)
      case "$backend" in
        apt) echo "nvidia-driver" ;;
        dnf|yum) echo "akmod-nvidia xorg-x11-drv-nvidia xorg-x11-drv-nvidia-libs" ;;
        zypper) echo "nvidia-computeG06 nvidia-glG06" ;;
        *) echo "" ;;
      esac
      ;;
  esac
}

deps_cuda_packages() {
  local family="$1"
  local backend="$2"
  case "$family" in
    arch) echo "cuda" ;;
    debian) echo "nvidia-cuda-toolkit" ;;
    fedora|rhel|suse) echo "cuda" ;;
    *)
      case "$backend" in
        apt) echo "nvidia-cuda-toolkit" ;;
        dnf|yum|zypper) echo "cuda" ;;
        *) echo "" ;;
      esac
      ;;
  esac
}

deps_nvidia_manual_hint() {
  local family="$1"
  local backend="$2"
  echo "Could not determine NVIDIA driver packages for distro=${family} pkg=${backend}."
  case "$backend" in
    apt) echo "Try: sudo apt install nvidia-driver" ;;
    dnf|yum) echo "Try: enable RPM Fusion, then sudo ${backend} install akmod-nvidia" ;;
    zypper) echo "Try: sudo zypper install nvidia-computeG06 nvidia-glG06" ;;
    pacman) echo "Try: sudo pacman -S nvidia-open-dkms nvidia-utils" ;;
    *) echo "Install the NVIDIA proprietary driver, then re-run: coldberth deps" ;;
  esac
}

deps_install_tools() {
  local backend="$1"
  pkg_install "$backend" curl git
}

deps_install_nvidia() {
  local family="$1"
  local backend="$2"
  local -a pkgs=()
  read -ra pkgs <<< "$(deps_nvidia_packages "$family" "$backend")"
  if [[ ${#pkgs[@]} -eq 0 || -z "${pkgs[0]}" ]]; then
    deps_nvidia_manual_hint "$family" "$backend"
    return 1
  fi
  if [[ "$family" == arch ]]; then
    echo "Arch: installing open NVIDIA driver (use nvidia-dkms for proprietary)."
  elif [[ "$family" == rhel && "$backend" != yum ]]; then
    echo "RHEL family: enable RPM Fusion if akmod-nvidia is not found."
  fi
  pkg_install "$backend" "${pkgs[@]}"
}

deps_install_cuda_toolkit() {
  local family="$1"
  local backend="$2"
  local -a pkgs=()
  read -ra pkgs <<< "$(deps_cuda_packages "$family" "$backend")"
  [[ ${#pkgs[@]} -gt 0 && -n "${pkgs[0]}" ]] || return 1
  pkg_install "$backend" "${pkgs[@]}"
}

deps_status() {
  local family backend missing_tools=0 missing_nvidia=0 missing_cuda=0
  family="$(os_family)"
  backend="$(pkg_backend)"

  echo "distro: ${family}"
  echo "pkg:    ${backend}"
  echo ""

  echo "== Required =="
  if command -v curl &>/dev/null; then
    echo "OK:   curl"
  else
    echo "MISS: curl"
    missing_tools=1
  fi
  if command -v git &>/dev/null; then
    echo "OK:   git"
  else
    echo "MISS: git"
    missing_tools=1
  fi
  if nvidia_smi_ok; then
    echo "OK:   nvidia-smi ($(nvidia-smi --query-gpu=name,driver_version --format=csv,noheader 2>/dev/null | head -1))"
  else
    echo "MISS: nvidia-smi (NVIDIA driver required for GPU inference)"
    missing_nvidia=1
  fi

  echo ""
  echo "== Optional =="
  if nvcc_ok; then
    if command -v nvcc &>/dev/null; then
      echo "OK:   nvcc (CUDA toolkit — FlashInfer speedup)"
    else
      echo "OK:   nvcc at /opt/cuda/bin/nvcc (set CUDA_HOME=/opt/cuda)"
    fi
  else
    echo "MISS: CUDA toolkit (optional — PyTorch fallback works without nvcc)"
    missing_cuda=1
  fi

  DEPS_MISSING_TOOLS=$missing_tools
  DEPS_MISSING_NVIDIA=$missing_nvidia
  DEPS_MISSING_CUDA=$missing_cuda
  DEPS_FAMILY=$family
  DEPS_BACKEND=$backend
  export DEPS_MISSING_TOOLS DEPS_MISSING_NVIDIA DEPS_MISSING_CUDA DEPS_FAMILY DEPS_BACKEND

  [[ "$missing_tools" -eq 0 && "$missing_nvidia" -eq 0 ]]
}

deps_usage() {
  cat <<EOF
Usage: coldberth deps [--check|--install]

  Check OS packages needed for NVIDIA GPU inference.

  Required: curl, git, working nvidia-smi (NVIDIA driver)
  Optional: CUDA toolkit (nvcc) for optional FlashInfer speedup

  Package managers: pacman, apt, dnf, yum, zypper (auto-detected)

  --check    Exit 0 if required deps OK, 1 if missing
  --install  Install missing packages without prompting (requires sudo)

  install runs this check and prompts automatically.
  COLDBERTH_DEPS=allow|skip  non-interactive install behavior
EOF
}

maybe_ensure_os_deps() {
  local mode="${1:-prompt}"
  local family backend

  echo "== OS dependencies =="
  if deps_status; then
    if [[ "$DEPS_MISSING_CUDA" -eq 1 && "$mode" != check ]]; then
      echo ""
      echo "Optional CUDA toolkit not installed (not required)."
    fi
    return 0
  fi

  family="$DEPS_FAMILY"
  backend="$DEPS_BACKEND"
  if [[ "$backend" == unknown ]]; then
    echo "ERROR: no supported package manager (apt, dnf, yum, zypper, pacman)."
    return 1
  fi
  echo ""

  case "$mode" in
    check) return 1 ;;
    install)
      ;;
    *)
      if [[ "${COLDBERTH_DEPS:-}" == skip ]]; then
        echo "Required dependencies missing (COLDBERTH_DEPS=skip)."
        return 1
      fi
      if [[ "${COLDBERTH_DEPS:-}" != allow ]]; then
        if [[ ! -t 0 ]]; then
          echo "Required dependencies missing — run: coldberth deps --install"
          return 1
        fi
      fi
      ;;
  esac

  local do_tools=0 do_nvidia=0 do_cuda=0
  [[ "$DEPS_MISSING_TOOLS" -eq 1 ]] && do_tools=1
  [[ "$DEPS_MISSING_NVIDIA" -eq 1 ]] && do_nvidia=1

  if [[ "$mode" == prompt && "${COLDBERTH_DEPS:-}" != allow ]]; then
    if [[ "$do_tools" -eq 1 || "$do_nvidia" -eq 1 ]]; then
      local ans
      read -r -p "Install missing required OS packages? [Y/n]: " ans
      case "${ans,,}" in
        n|no) echo "Skipped. Fix manually: coldberth deps"; return 1 ;;
      esac
    fi
    if [[ "$DEPS_MISSING_CUDA" -eq 1 ]]; then
      local ans_cuda
      read -r -p "Install optional CUDA toolkit (nvcc)? [y/N]: " ans_cuda
      case "${ans_cuda,,}" in
        y|yes) do_cuda=1 ;;
      esac
    fi
  elif [[ "$mode" == install || "${COLDBERTH_DEPS:-}" == allow ]]; then
    :
  fi

  if [[ "$do_tools" -eq 1 ]]; then
    echo ""
    echo "Installing curl + git..."
    deps_install_tools "$backend" || return 1
  fi
  if [[ "$do_nvidia" -eq 1 ]]; then
    echo ""
    echo "Installing NVIDIA driver packages..."
    deps_install_nvidia "$family" "$backend" || return 1
    echo ""
    echo "NOTE: NVIDIA driver install may require a reboot before nvidia-smi works."
    if ! nvidia_smi_ok; then
      echo "Reboot, then run: coldberth deps && coldberth install"
      return 1
    fi
  fi
  if [[ "$do_cuda" -eq 1 ]]; then
    echo ""
    echo "Installing CUDA toolkit..."
    deps_install_cuda_toolkit "$family" "$backend" || true
  fi

  echo ""
  deps_status
}

cmd_deps() {
  require_linux
  local mode=prompt
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --check) mode=check; shift ;;
      --install) mode=install; shift ;;
      -h|--help) deps_usage; return 0 ;;
      *) echo "Unknown option: $1"; deps_usage; exit 1 ;;
    esac
  done
  maybe_ensure_os_deps "$mode"
}

require_gpu() {
  if ! command -v nvidia-smi &>/dev/null; then
    echo "WARN: nvidia-smi not found — GPU inference will not work"
    return 1
  fi
  nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
}

ensure_uv() {
  if command -v uv &>/dev/null; then
    return 0
  fi
  echo "Installing uv..."
  curl -LsSf https://astral.sh/uv/install.sh | sh
  export PATH="$HOME/.local/bin:$PATH"
  command -v uv &>/dev/null || { echo "ERROR: uv install failed"; exit 1; }
}

link_cli() {
  local root="${1:-$ROOT}"
  mkdir -p "$HOME/.local/bin"
  ln -sf "$root/bin/coldberth" "$HOME/.local/bin/coldberth"
  echo "Linked: $HOME/.local/bin/coldberth -> $root/bin/coldberth"
}

coldberth_src_dir() {
  if [[ -n "${COLDBERTH_DIR:-}" ]] && [[ -d "${COLDBERTH_DIR}/.git" ]]; then
    echo "$(cd "${COLDBERTH_DIR}" && pwd)"
    return 0
  fi
  local default="$HOME/.local/share/coldberth/src"
  if [[ -d "$default/.git" ]]; then
    echo "$default"
    return 0
  fi
  if [[ -d "$ROOT/.git" ]]; then
    echo "$ROOT"
    return 0
  fi
  return 1
}

venv_python_version() {
  "$VENV/bin/python" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null || true
}

upgrade_vllm_venv() {
  ensure_uv
  mkdir -p "$DATA"
  echo "== vLLM venv ($VENV, Python ${PYTHON}) =="
  if [[ -x "$VENV/bin/python" ]]; then
    local current
    current="$(venv_python_version)"
    if [[ -n "$current" && "$current" != "$PYTHON" ]]; then
      echo "Recreating venv: Python ${current} -> ${PYTHON}"
      rm -rf "$VENV"
    fi
  fi
  if [[ ! -x "$VENV/bin/python" ]]; then
    uv venv --python "$PYTHON" --seed --managed-python "$VENV"
  else
    echo "Upgrading packages..."
  fi
  # shellcheck disable=SC1091
  source "$VENV/bin/activate"
  uv pip install --upgrade vllm --torch-backend=auto
  python -c "import torch; assert torch.cuda.is_available(), 'CUDA not available to PyTorch'"
}

update_usage() {
  cat <<EOF
Usage: coldberth update

  Pull latest coldberth from git, refresh ~/.local/bin/coldberth, upgrade vLLM in the venv.

  Source checkout (first match):
    \$COLDBERTH_DIR, ~/.local/share/coldberth/src, or this repo if run from a git clone.

  Bootstrap (clone + update): curl -fsSL .../install.sh | bash
EOF
}

cmd_update_venv() {
  local src="${1:-$ROOT}"
  upgrade_vllm_venv
  link_cli "$src"
  local rev="unknown"
  if [[ -d "$src/.git" ]]; then
    rev="$(git -C "$src" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  fi
  echo ""
  echo "Updated coldberth @ ${rev}"
  if vllm_ready; then
    echo "vLLM is still running on the old build — restart: coldberth stop && coldberth start -b"
  else
    echo "Next: coldberth start -b"
  fi
}

coldberth_upstream_ref() {
  local src="$1"
  local branch upstream
  branch="$(git -C "$src" rev-parse --abbrev-ref HEAD 2>/dev/null)" || return 1
  upstream="$(git -C "$src" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)" \
    || upstream="origin/${branch}"
  echo "$upstream"
}

coldberth_behind_upstream() {
  local src="$1"
  local upstream local_rev remote_rev
  upstream="$(coldberth_upstream_ref "$src")" || return 1
  remote_rev="$(git -C "$src" rev-parse "$upstream" 2>/dev/null)" || return 1
  local_rev="$(git -C "$src" rev-parse HEAD 2>/dev/null)" || return 1
  [[ "$local_rev" == "$remote_rev" ]] && return 1
  git -C "$src" merge-base --is-ancestor HEAD "$remote_rev" 2>/dev/null
}

maybe_notify_update_available() {
  [[ "${COLDBERTH_UPDATE_CHECK:-}" != skip ]] || return 0
  local src
  if ! src="$(coldberth_src_dir)"; then
    return 0
  fi

  local stamp_file="$DATA/last-update-check"
  local now interval last_fetch=0
  now="$(date +%s)"
  interval="${COLDBERTH_UPDATE_CHECK_INTERVAL:-21600}"
  [[ -f "$stamp_file" ]] && last_fetch="$(cat "$stamp_file" 2>/dev/null || echo 0)"

  if (( now - last_fetch >= interval )); then
    if timeout 12 git -C "$src" fetch --quiet origin 2>/dev/null; then
      echo "$now" >"$stamp_file"
    fi
  fi

  if ! coldberth_behind_upstream "$src"; then
    return 0
  fi

  local upstream local_short remote_short
  upstream="$(coldberth_upstream_ref "$src")"
  local_short="$(git -C "$src" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  remote_short="$(git -C "$src" rev-parse --short "$upstream" 2>/dev/null || echo unknown)"
  echo "NOTE: coldberth update available (${local_short} -> ${remote_short}). Run: coldberth update"
}

cmd_update() {
  require_linux
  local src
  if ! src="$(coldberth_src_dir)"; then
    echo "ERROR: no coldberth git checkout found."
    echo "Install first:"
    echo "  curl -fsSL https://raw.githubusercontent.com/DataKnifeAI/coldberth/main/install.sh | bash"
    exit 1
  fi

  echo "== Update coldberth =="
  echo "source: $src"
  if vllm_ready; then
    echo "note:  vLLM is running — plan to restart after update"
  fi
  echo ""
  echo "== git pull =="
  git -C "$src" pull --ff-only
  date +%s >"$DATA/last-update-check"
  echo ""
  exec "$src/bin/coldberth" _update_venv "$src"
}

cmd_install() {
  require_linux
  maybe_ensure_os_deps prompt || {
    echo ""
    echo "ERROR: required OS dependencies missing."
    echo "  coldberth deps"
    echo "  coldberth deps --install"
    exit 1
  }
  echo ""
  echo "== GPU =="
  require_gpu || true
  ensure_uv
  upgrade_vllm_venv
  link_cli
  if [[ -d /opt/cuda/bin ]] && ! grep -q 'CUDA_HOME=/opt/cuda' "$HOME/.bashrc" 2>/dev/null; then
    cat >> "$HOME/.bashrc" <<'EOF'

# coldberth: CUDA toolkit for FlashInfer JIT (optional)
export CUDA_HOME=/opt/cuda
export PATH="$CUDA_HOME/bin:$PATH"
EOF
    echo "Appended CUDA_HOME hints to ~/.bashrc (optional FlashInfer speedup)"
  fi
  echo ""
  echo "Done. Next:"
  echo "  coldberth recommend  # GPU → model/settings for Hermes Agent"
  echo "  coldberth doctor"
  echo "  coldberth start -b   # background (or foreground in another terminal)"
  echo "  # install Hermes Agent, then coldberth configure or hermes setup"
  echo "  hermes chat"
}

require_venv() {
  if [[ ! -x "$VENV/bin/vllm" ]]; then
    echo "ERROR: vLLM not installed. Run: coldberth install"
    exit 1
  fi
}

vllm_env() {
  export VLLM_USE_FLASHINFER_SAMPLER=0
  if [[ -n "${CUDA_HOME:-}" ]] && [[ -x "${CUDA_HOME}/bin/nvcc" ]]; then
    unset VLLM_USE_FLASHINFER_SAMPLER
  fi
}

lan_ip() {
  ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit }}' \
    || hostname -I 2>/dev/null | awk '{print $1}' \
    || true
}

vllm_local_base() {
  echo "http://127.0.0.1:${PORT}/v1"
}

vllm_lan_base() {
  local ip
  ip="$(lan_ip)"
  [[ -n "$ip" ]] && echo "http://${ip}:${PORT}/v1"
}

vllm_ready() {
  curl -sf --max-time 2 "$(vllm_local_base)/models" &>/dev/null
}

vllm_lan_bound() {
  ss -ltnH 2>/dev/null | grep -qE "0\.0\.0\.0:${PORT}[[:space:]]"
}

start_usage() {
  cat <<EOF
Usage: coldberth start [-b|--background] [-l|--lan] [--no-firewall]

  (default)   Bind 127.0.0.1 only (local Hermes on this machine)
  -l, --lan   Bind 0.0.0.0 — expose vLLM on the LAN for remote Hermes agents
  -b, --background   Detach; logs to \$COLDBERTH_LOG (default: $LOG_FILE)
  --no-firewall   Skip firewall detect/prompt (also: COLDBERTH_FIREWALL=skip)

  Distributed Hermes: GPU host runs "coldberth start -b --lan"; controller runs
  "coldberth configure --url http://<gpu-host>:${PORT}/v1"
EOF
}

configure_usage() {
  cat <<EOF
Usage: coldberth configure [--url BASE_URL] [--lan]

  (default)   http://127.0.0.1:${PORT}/v1 — Hermes on the same machine as vLLM
  --url URL   Custom OpenAI base URL (remote GPU / Hermes-controlling-Hermes)
  --lan       Use this machine's LAN IP (GPU host; remote agents use urls output)
EOF
}

normalize_base_url() {
  local u="${1%/}"
  [[ "$u" == */v1 ]] || u="${u}/v1"
  echo "$u"
}

print_lan_warning() {
  echo "WARN: LAN mode — no API auth. Trusted local network only."
}

lan_subnet() {
  local dev
  dev="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit }}')"
  [[ -n "$dev" ]] || return 1
  ip -4 route show dev "$dev" 2>/dev/null \
    | awk '/proto kernel scope link/ && $1 != "default" { print $1; exit }'
}

ufw_active() {
  [[ -f /etc/ufw/ufw.conf ]] && grep -q '^ENABLED=yes' /etc/ufw/ufw.conf
}

firewalld_active() {
  if command -v firewall-cmd &>/dev/null && firewall-cmd --state 2>/dev/null | grep -qi '^running'; then
    return 0
  fi
  systemctl is-active firewalld &>/dev/null
}

firewall_backend() {
  if command -v ufw &>/dev/null && ufw_active; then
    echo ufw
    return 0
  fi
  if firewalld_active; then
    echo firewalld
    return 0
  fi
  echo none
}

ufw_port_allowed() {
  local port="$1"
  if [[ -r /etc/ufw/user.rules ]] \
    && grep -qE "ufw-user-input -p tcp --dport ${port}( |$)" /etc/ufw/user.rules; then
    return 0
  fi
  if command -v ufw &>/dev/null; then
    sudo ufw status 2>/dev/null \
      | grep -qE "(ALLOW|ALLOW IN).*[[:space:]]${port}(/tcp)?([[:space:]]|$)" \
      && return 0
    sudo ufw status numbered 2>/dev/null | grep -qE "${port}(/tcp)?"
  fi
}

firewall_port_allowed() {
  local backend="$1"
  local port="$2"
  case "$backend" in
    ufw)
      ufw_port_allowed "$port"
      ;;
    firewalld)
      firewall-cmd --query-port="${port}/tcp" &>/dev/null \
        || sudo firewall-cmd --query-port="${port}/tcp" &>/dev/null
      ;;
    none)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

firewall_allow_lan_port() {
  local backend="$1"
  local port="$2"
  local subnet="${3:-}"
  case "$backend" in
    ufw)
      if [[ -n "$subnet" ]]; then
        sudo ufw allow from "$subnet" to any port "$port" proto tcp comment 'coldberth vLLM'
      else
        sudo ufw allow "${port}/tcp" comment 'coldberth vLLM'
      fi
      ;;
    firewalld)
      sudo firewall-cmd --permanent --add-port="${port}/tcp"
      sudo firewall-cmd --reload
      ;;
    *)
      echo "No supported firewall backend to configure."
      return 1
      ;;
  esac
}

firewall_status_line() {
  local backend
  backend="$(firewall_backend)"
  case "$backend" in
    none)
      echo "firewall: none detected (or inactive)"
      return 0
      ;;
    ufw|firewalld)
      if firewall_port_allowed "$backend" "$PORT"; then
        echo "firewall: ${backend} — port ${PORT}/tcp allowed"
        return 0
      fi
      echo "firewall: ${backend} active — port ${PORT}/tcp NOT open for LAN clients"
      return 1
      ;;
  esac
}

maybe_ensure_firewall_lan() {
  local mode="${1:-prompt}"
  local backend subnet
  backend="$(firewall_backend)"
  [[ "$backend" != none ]] || return 0
  if firewall_port_allowed "$backend" "$PORT"; then
    echo "Firewall: ${backend} allows TCP ${PORT}"
    return 0
  fi

  subnet="$(lan_subnet || true)"
  echo ""
  echo "Firewall (${backend}) may block remote Hermes clients on port ${PORT}."
  if [[ -n "$subnet" ]]; then
    echo "Suggested: allow from ${subnet} to port ${PORT}/tcp"
  else
    echo "Suggested: allow port ${PORT}/tcp"
  fi

  case "$mode" in
    check) return 1 ;;
    allow)
      firewall_allow_lan_port "$backend" "$PORT" "$subnet"
      echo "Firewall updated."
      return 0
      ;;
  esac

  if [[ "${COLDBERTH_FIREWALL:-}" == skip ]]; then
    echo "Skipped (COLDBERTH_FIREWALL=skip). Run: coldberth firewall --allow"
    return 1
  fi
  if [[ "${COLDBERTH_FIREWALL:-}" == allow ]]; then
    firewall_allow_lan_port "$backend" "$PORT" "$subnet"
    echo "Firewall updated."
    return 0
  fi
  if [[ ! -t 0 ]]; then
    echo "Non-interactive shell — run: coldberth firewall --allow"
    return 1
  fi

  local ans
  read -r -p "Allow LAN access on port ${PORT}? [Y/n]: " ans
  case "${ans,,}" in
    n|no)
      echo "Skipped. Remote clients may be unreachable until you run: coldberth firewall --allow"
      return 1
      ;;
    *)
      firewall_allow_lan_port "$backend" "$PORT" "$subnet"
      echo "Firewall updated."
      return 0
      ;;
  esac
}

firewall_usage() {
  cat <<EOF
Usage: coldberth firewall [--check|--allow]

  Check whether the host firewall allows remote access to vLLM on port ${PORT}.
  With --lan / distributed Hermes, remote clients need TCP ${PORT} open.

  --check   Exit 0 if port is allowed (or no firewall), 1 if blocked
  --allow   Add firewall rule without prompting (requires sudo)
EOF
}

cmd_firewall() {
  local mode=prompt
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --check) mode=check; shift ;;
      --allow) mode=allow; shift ;;
      -h|--help) firewall_usage; return 0 ;;
      *) echo "Unknown option: $1"; firewall_usage; exit 1 ;;
    esac
  done

  firewall_status_line || true
  maybe_ensure_firewall_lan "$mode"
}

prepare_vllm() {
  require_venv
  # shellcheck disable=SC1091
  source "$VENV/bin/activate"
  vllm_env
  extra_args=()
  [[ -n "$KV_CACHE_DTYPE" ]] && extra_args+=(--kv-cache-dtype "$KV_CACHE_DTYPE")
}

cmd_start() {
  local background=0
  local bind_host="127.0.0.1"
  local skip_firewall=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -b|--background) background=1; shift ;;
      -l|--lan) bind_host="0.0.0.0"; shift ;;
      --no-firewall) skip_firewall=1; shift ;;
      -h|--help) start_usage; return 0 ;;
      *) echo "Unknown option: $1"; start_usage; exit 1 ;;
    esac
  done
  [[ "$skip_firewall" -eq 0 ]] || export COLDBERTH_FIREWALL=skip
  maybe_notify_update_available || true

  if vllm_ready; then
    echo "vLLM already running on $(vllm_local_base)"
    [[ -f "$PID_FILE" ]] && echo "pid: $(cat "$PID_FILE")"
    cmd_urls 2>/dev/null || true
    if [[ "$bind_host" == "0.0.0.0" ]] || vllm_lan_bound; then
      maybe_ensure_firewall_lan prompt || true
    fi
    return 0
  fi

  prepare_vllm
  echo "Starting vLLM on ${bind_host}:${PORT} (model=${SERVED_NAME}, context=${MAX_LEN})"
  echo "Local API: $(vllm_local_base)"
  if [[ "$bind_host" == "0.0.0.0" ]]; then
    print_lan_warning
    local lan
    lan="$(vllm_lan_base)"
    [[ -n "$lan" ]] && echo "LAN API:   ${lan}"
    maybe_ensure_firewall_lan prompt || true
  fi

  if [[ "$background" -eq 0 ]]; then
    exec vllm serve "$MODEL" \
      --host "$bind_host" \
      --port "$PORT" \
      --max-model-len "$MAX_LEN" \
      --gpu-memory-utilization "$GPU_UTIL" \
      --quantization awq \
      --enable-auto-tool-choice \
      --tool-call-parser hermes \
      --served-model-name "$SERVED_NAME" \
      --no-enable-flashinfer-autotune \
      "${extra_args[@]}"
  fi

  mkdir -p "$DATA"
  nohup vllm serve "$MODEL" \
    --host "$bind_host" \
    --port "$PORT" \
    --max-model-len "$MAX_LEN" \
    --gpu-memory-utilization "$GPU_UTIL" \
    --quantization awq \
    --enable-auto-tool-choice \
    --tool-call-parser hermes \
    --served-model-name "$SERVED_NAME" \
    --no-enable-flashinfer-autotune \
    "${extra_args[@]}" >>"$LOG_FILE" 2>&1 &
  local pid=$!
  echo "$pid" >"$PID_FILE"
  echo "Background pid: $pid"
  echo "Log: $LOG_FILE"

  for _ in $(seq 1 90); do
    if vllm_ready; then
      echo "Ready: $(vllm_local_base)"
      if [[ "$bind_host" == "0.0.0.0" ]]; then
        local lan
        lan="$(vllm_lan_base)"
        [[ -n "$lan" ]] && echo "LAN:   ${lan}"
        echo "Remote Hermes: coldberth configure --url ${lan:-http://<this-host>:${PORT}/v1}"
        firewall_status_line || true
      fi
      return 0
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "ERROR: vLLM exited during startup. Last log lines:"
      tail -20 "$LOG_FILE" 2>/dev/null || true
      rm -f "$PID_FILE"
      return 1
    fi
    sleep 2
  done

  echo "WARN: still starting after 3m — check: tail -f $LOG_FILE"
  return 0
}

gpu_vram_summary() {
  command -v nvidia-smi &>/dev/null || return 0
  nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null \
    | head -1 \
    | awk -F', ' '{printf "GPU VRAM: %s MiB used / %s MiB total\n", $1, $2}'
}

cmd_stop() {
  local was_running=0
  if vllm_ready; then
    was_running=1
  fi

  if [[ -f "$PID_FILE" ]]; then
    kill "$(cat "$PID_FILE")" 2>/dev/null || true
    rm -f "$PID_FILE"
  fi
  pkill -f "${VENV}/bin/vllm serve" 2>/dev/null || true
  pkill -f 'vllm serve.*hermes3:8b' 2>/dev/null || true
  sleep 1

  if vllm_ready; then
    echo "WARN: port ${PORT} still responding"
    return 1
  fi

  if [[ "$was_running" -eq 1 ]]; then
    echo "vLLM stopped — GPU VRAM released for games and other heavy GPU tasks"
  else
    echo "vLLM not running (port ${PORT} down)"
  fi
  gpu_vram_summary || true
  echo "Resume inference: coldberth start -b"
}

cmd_recommend() {
  python3 - "$@" <<'PY'
import json, os, shutil, subprocess, sys

HERMES_MIN_CTX = 65536
DATA = os.path.expanduser(os.environ.get("COLDBERTH_DATA", os.path.expanduser("~/.local/share/coldberth")))

def query_gpu():
    if not shutil.which("nvidia-smi"):
        return None
    r = subprocess.run(
        [
            "nvidia-smi",
            "--query-gpu=index,name,memory.total,memory.free,memory.used",
            "--format=csv,noheader,nounits",
        ],
        capture_output=True,
        text=True,
    )
    if r.returncode != 0 or not r.stdout.strip():
        return None
    rows = []
    for line in r.stdout.strip().splitlines():
        idx, name, total, free, used = [x.strip() for x in line.split(",")]
        rows.append(
            {
                "index": int(idx),
                "name": name,
                "total_mib": int(total),
                "free_mib": int(free),
                "used_mib": int(used),
            }
        )
    return rows

def other_compute_vram():
    r = subprocess.run(
        [
            "nvidia-smi",
            "--query-compute-apps=pid,process_name,used_gpu_memory",
            "--format=csv,noheader,nounits",
        ],
        capture_output=True,
        text=True,
    )
    apps = []
    if r.returncode == 0:
        for line in r.stdout.strip().splitlines():
            if not line.strip():
                continue
            parts = [p.strip() for p in line.split(",")]
            if len(parts) >= 3:
                apps.append(
                    {
                        "pid": parts[0],
                        "name": parts[1],
                        "vram_mib": int(parts[2]) if parts[2].isdigit() else 0,
                    }
                )
    return apps

def pick_profile(total_mib, free_mib, shared_gpu):
    awq = {
        "model": "solidrust/Hermes-3-Llama-3.1-8B-AWQ",
        "served_name": "hermes3:8b",
        "quantization": "awq",
        "kv_cache_dtype": "fp8",
        "context_length": HERMES_MIN_CTX,
        "tool_parser": "hermes",
        "uncensored": True,
        "tools": True,
    }

    if total_mib < 8000:
        return {
            **awq,
            "tier": "unsupported",
            "gpu_util": None,
            "context_length": HERMES_MIN_CTX,
            "feasible": False,
            "summary": "GPU VRAM too small for Hermes Agent at 64k context.",
            "notes": [
                "Hermes Agent needs at least 64k context for reliable tool loops.",
                "Use a cloud provider in Hermes, or a GPU with 12GB+ VRAM.",
            ],
        }

    if total_mib < 12000:
        return {
            **awq,
            "tier": "8gb-class",
            "gpu_util": 0.92,
            "feasible": False,
            "summary": "10–12GB GPUs usually cannot hold Hermes 3 8B AWQ at 64k.",
            "notes": [
                "You may get OOM even with fp8 KV cache and max GPU util.",
                "Upgrade to 16GB+ VRAM, or use Hermes with a cloud API.",
            ],
        }

    if total_mib < 16000:
        util = 0.90 if free_mib >= 10000 and not shared_gpu else 0.82
        return {
            **awq,
            "tier": "12gb-class",
            "gpu_util": util,
            "feasible": free_mib >= 9000,
            "summary": "12GB VRAM: Hermes 3 8B AWQ at 64k is tight but often works.",
            "notes": [
                "Close browsers, games, and Ollama before starting.",
                "First start may take 1–2 minutes while weights download.",
            ],
        }

    if total_mib < 22000:
        util = 0.80 if free_mib >= 14000 and not shared_gpu else 0.70
        return {
            **awq,
            "tier": "16gb-class",
            "gpu_util": util,
            "feasible": free_mib >= 11000,
            "summary": "16GB VRAM: good fit for Hermes 3 8B AWQ + 64k agent context.",
            "notes": [
                "Close other GPU apps if startup reports insufficient memory.",
            ],
        }

    util = 0.75 if free_mib >= 18000 and not shared_gpu else 0.65
    profile = {
        **awq,
        "tier": "24gb-class",
        "gpu_util": util,
        "feasible": free_mib >= 14000,
        "summary": "24GB VRAM: ideal for Coldberth defaults (fast uncensored Hermes agent).",
        "notes": [
            "Measured ~20GB VRAM at 64k + fp8 KV on RTX 4090.",
        ],
    }
    if total_mib >= 40000 and free_mib >= 30000:
        profile["alt_model"] = "NousResearch/Hermes-3-Llama-3.1-8B"
        profile["alt_notes"] = (
            "BF16 weights need ~16GB+ free; 64k KV may still not fit — try only on a clean GPU."
        )
    return profile

def shell_exports(profile):
    lines = [
        f'export COLDBERTH_MODEL="{profile["model"]}"',
        f'export COLDBERTH_SERVED_NAME="{profile["served_name"]}"',
        f'export COLDBERTH_MAX_MODEL_LEN={profile["context_length"]}',
        f'export COLDBERTH_KV_CACHE_DTYPE={profile["kv_cache_dtype"]}',
    ]
    if profile.get("gpu_util") is not None:
        lines.append(f'export COLDBERTH_GPU_UTIL={profile["gpu_util"]}')
    return lines

def write_env_file(profile, path):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write("# Generated by: coldberth recommend --apply\n")
        for line in shell_exports(profile):
            f.write(line + "\n")
    return path

args = sys.argv[1:]
shell_only = "--shell" in args
json_only = "--json" in args
apply = "--apply" in args

gpus = query_gpu()
if not gpus:
    print("ERROR: nvidia-smi not found or no NVIDIA GPU detected.", file=sys.stderr)
    print("Hermes Agent local inference requires an NVIDIA GPU + driver.", file=sys.stderr)
    sys.exit(1)

gpu = gpus[0]
apps = other_compute_vram()
shared = gpu["used_mib"] > 2048 or len(apps) > 0
profile = pick_profile(gpu["total_mib"], gpu["free_mib"], shared)
profile["gpu"] = gpu
profile["shared_gpu"] = shared
profile["compute_apps"] = apps
profile["hermes_min_context"] = HERMES_MIN_CTX

if json_only:
    print(json.dumps(profile, indent=2))
    sys.exit(0 if profile.get("feasible", True) else 2)

if shell_only:
    if not profile.get("feasible", True):
        print("# WARNING: current free VRAM may be too low — close GPU apps first", file=sys.stderr)
    for line in shell_exports(profile):
        print(line)
    sys.exit(0 if profile.get("feasible", True) else 2)

if apply:
    path = write_env_file(profile, os.path.join(DATA, "recommended.env"))
    print(f"Wrote {path}")
    print("  source ~/.local/share/coldberth/recommended.env")
    print("  coldberth start -b && coldberth configure && hermes chat")

print("== GPU ==")
print(f"device:     {gpu['name']} (cuda:{gpu['index']})")
print(f"vram total: {gpu['total_mib']} MiB")
print(f"vram free:  {gpu['free_mib']} MiB")
print(f"vram used:  {gpu['used_mib']} MiB")
if shared:
    print("status:     shared (other processes using GPU)")
    for app in apps[:5]:
        print(f"  - pid {app['pid']} {app['name']}: {app['vram_mib']} MiB")
else:
    print("status:     mostly idle")
print()

print("== Hermes Agent requirements ==")
print(f"  context_length >= {HERMES_MIN_CTX} (agent tool loops)")
print("  model with native tool calling + hermes parser")
print("  Hermes CLI: install after coldberth start — hermes setup → Full setup → Custom")
print("              (or: coldberth configure)")
print()

print("== Recommendation ==")
print(f"tier:    {profile['tier']}")
print(f"summary: {profile['summary']}")
print(f"feasible now: {'yes' if profile.get('feasible', True) else 'no — free more VRAM'}")
print()
print("model:       ", profile["model"])
print("served name: ", profile["served_name"])
print("context:     ", profile["context_length"])
print("kv cache:    ", profile["kv_cache_dtype"])
if profile.get("gpu_util") is not None:
    print("gpu util:    ", profile["gpu_util"])
print("tools:       ", "yes" if profile["tools"] else "no")
print("uncensored:  ", "yes" if profile["uncensored"] else "no")
print()

for note in profile.get("notes", []):
    print(f"  • {note}")
if profile.get("alt_model"):
    print()
    print(f"optional (higher quality, tighter VRAM): {profile['alt_model']}")
    print(f"  {profile.get('alt_notes', '')}")
print()

print("== Apply settings ==")
print("Copy/paste before coldberth start:")
print()
for line in shell_exports(profile):
    print(line)
print()
print("Or persist:")
print("  coldberth recommend --apply")
print("  source ~/.local/share/coldberth/recommended.env")
print()
print("Then:")
print("  coldberth install   # if not done")
print("  coldberth start -b")
print("  # install Hermes Agent, then coldberth configure or hermes setup")
print("  hermes chat")

sys.exit(0 if profile.get("feasible", True) else 2)
PY
}

recommend_usage() {
  cat <<EOF
Usage: coldberth recommend [--shell|--json|--apply]

  Detect GPU VRAM and suggest model/settings for Hermes Agent (64k context).

  --shell   Print export commands only (eval: eval "\$(coldberth recommend --shell)")
  --json    Machine-readable output
  --apply   Write ~/.local/share/coldberth/recommended.env
EOF
}

cmd_doctor() {
  echo "== coldberth =="
  echo "data:  $DATA"
  echo "venv:  $VENV"
  echo "port:  $PORT"
  echo "bind:  127.0.0.1 (default loopback; start --lan → 0.0.0.0)"
  echo "model: $MODEL -> $SERVED_NAME"
  echo ""
  echo "== GPU =="
  require_gpu || true
  echo "Tip: coldberth recommend — GPU-specific model/settings for Hermes Agent"
  echo ""
  echo ""
  echo "== CUDA toolkit =="
  if command -v nvcc &>/dev/null; then
    nvcc --version | tail -1
  elif [[ -x /opt/cuda/bin/nvcc ]]; then
    echo "nvcc at /opt/cuda/bin/nvcc (not in PATH — set CUDA_HOME=/opt/cuda)"
  else
    echo "nvcc not found (OK — PyTorch sampler fallback enabled)"
  fi
  echo ""
  echo "== vLLM venv =="
  if [[ -x "$VENV/bin/vllm" ]]; then
    echo "OK: $VENV/bin/vllm (Python $(venv_python_version || echo unknown), target ${PYTHON})"
    # shellcheck disable=SC1091
    source "$VENV/bin/activate"
    python -c "import torch; print('torch', torch.__version__, 'cuda', torch.cuda.is_available())"
  else
    echo "MISSING: run coldberth install"
  fi
  echo ""
  echo "== Hermes =="
  if command -v hermes &>/dev/null; then
    echo "OK: $(command -v hermes)"
  else
    echo "hermes CLI not found — install after coldberth start: https://github.com/NousResearch/hermes-agent"
  fi
  echo ""
  echo "== Endpoint =="
  if vllm_ready; then
    cmd_urls
    echo ""
    curl -sf --max-time 3 "$(vllm_local_base)/models" | python3 -m json.tool 2>/dev/null | head -15
    if vllm_lan_bound; then
      echo ""
      print_lan_warning
      firewall_status_line || maybe_ensure_firewall_lan prompt || true
    fi
  else
    echo "vLLM not running on port ${PORT} (coldberth start)"
  fi
  echo ""
  echo "== Firewall =="
  firewall_status_line || true
}

cmd_urls() {
  echo "local: $(vllm_local_base)"
  if vllm_lan_bound; then
    local lan
    lan="$(vllm_lan_base)"
    if [[ -n "$lan" ]]; then
      echo "lan:   ${lan}"
      echo "remote hermes: coldberth configure --url ${lan}"
    else
      echo "lan:   bound on 0.0.0.0 (could not detect LAN IP for --url)"
    fi
  else
    echo "lan:   not exposed (default loopback — use: coldberth start --lan)"
  fi
}

cmd_bench() {
  python3 <<PY
import json, subprocess, time, sys
url = "$(vllm_local_base)/chat/completions"
model = "${SERVED_NAME}"
tool = [{"type":"function","function":{"name":"calculator","description":"add","parameters":{"type":"object","properties":{"a":{"type":"number"},"b":{"type":"number"}},"required":["a","b"]}}}]
payload = {"model":model,"messages":[{"role":"user","content":"calculator a=2 b=2"}],"tools":tool,"tool_choice":"required","max_tokens":80,"temperature":0}
t0 = time.time()
r = subprocess.run(["curl","-s",url,"-H","Content-Type: application/json","-d",json.dumps(payload)],capture_output=True,text=True)
dt = time.time()-t0
try:
    d = json.loads(r.stdout)
    tc = d["choices"][0]["message"].get("tool_calls")
    print(f"latency={dt:.2f}s tool_calls={bool(tc)}")
    if tc: print(json.dumps(tc[0], indent=2))
    sys.exit(0 if tc else 1)
except Exception as e:
    print("FAIL:", e, r.stdout[:300])
    sys.exit(1)
PY
}

cmd_configure() {
  local base_url=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --url)
        [[ $# -ge 2 ]] || { echo "ERROR: --url requires an argument"; configure_usage; exit 1; }
        base_url="$2"
        shift 2
        ;;
      --lan)
        local ip
        ip="$(lan_ip)"
        [[ -n "$ip" ]] || { echo "ERROR: could not detect LAN IP"; exit 1; }
        base_url="http://${ip}:${PORT}/v1"
        shift
        ;;
      -h|--help) configure_usage; return 0 ;;
      *) echo "Unknown option: $1"; configure_usage; exit 1 ;;
    esac
  done
  [[ -n "$base_url" ]] || base_url="$(vllm_local_base)"
  base_url="$(normalize_base_url "$base_url")"

  mkdir -p "$(dirname "$HERMES_CONFIG")"
  if [[ ! -f "$HERMES_CONFIG" ]]; then
    echo "ERROR: $HERMES_CONFIG not found — run hermes setup first"
    exit 1
  fi
  cp -a "$HERMES_CONFIG" "${HERMES_CONFIG}.bak.$(date +%Y%m%d%H%M%S)"
  python3 <<PY
from pathlib import Path
import re
path = Path("${HERMES_CONFIG}")
text = path.read_text()
provider = "${PROVIDER_NAME}"
model = "${SERVED_NAME}"
ctx = ${MAX_LEN}
base = "${base_url}"

# model block
text = re.sub(r"(?m)^  default:.*", f"  default: {model}", text, count=1)
text = re.sub(r"(?m)^  provider:.*", f"  provider: custom:{provider}", text, count=1)
text = re.sub(r"(?m)^  context_length:.*", f"  context_length: {ctx}", text, count=1)

block = f"""  - name: {provider}
    base_url: {base}
    models:
      {model}:
        context_length: {ctx}
"""
if "custom_providers:" not in text:
    text += f"\ncustom_providers:\n{block}"
else:
    # replace or append provider entry
    pat = rf"(?ms)  - name: {re.escape(provider)}\n.*?(?=\n  - name:|\nz|\n#|\nfallback_providers:|\n[a-z_]+:)"
    if re.search(pat, text):
        text = re.sub(pat, block.rstrip() + "\n", text)
    else:
        text = text.replace("custom_providers:\n", f"custom_providers:\n{block}", 1)

path.write_text(text)
print(f"Updated {path}")
print(f"  provider: custom:{provider}")
print(f"  base_url: {base}")
print(f"  model:    {model}")
PY
  echo "Backup saved alongside config. Run: hermes chat"
}

cmd_status() {
  if ! vllm_ready; then
    echo "down"
    return 1
  fi
  [[ -f "$PID_FILE" ]] && echo "pid: $(cat "$PID_FILE")"
  cmd_urls
  echo ""
  curl -sf "$(vllm_local_base)/models" | python3 -m json.tool 2>/dev/null
}

main() {
  case "${1:-help}" in
    deps)
      shift
      case "${1:-}" in
        -h|--help) deps_usage ;;
        *) cmd_deps "$@" ;;
      esac
      ;;
    install) cmd_install ;;
    update)
      shift
      case "${1:-}" in
        -h|--help) update_usage ;;
        *) cmd_update "$@" ;;
      esac
      ;;
    _update_venv) shift; cmd_update_venv "${1:-$ROOT}" ;;
    start) shift; cmd_start "$@" ;;
    stop|pause) cmd_stop ;;
    doctor) cmd_doctor ;;
    recommend)
      shift
      case "${1:-}" in
        -h|--help) recommend_usage ;;
        *) cmd_recommend "$@" ;;
      esac
      ;;
    bench) cmd_bench ;;
    configure) shift; cmd_configure "$@" ;;
    urls) cmd_urls ;;
    firewall)
      shift
      case "${1:-}" in
        -h|--help) firewall_usage ;;
        *) cmd_firewall "$@" ;;
      esac
      ;;
    status) cmd_status ;;
    help|-h|--help) usage ;;
    *) echo "Unknown command: $1"; usage; exit 1 ;;
  esac
}

main "$@"
